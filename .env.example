PORT=3000
DB_PATH=./data/agenter.db
AUTH_COOKIE_SECURE=false

# Для HTTPS установите AUTH_COOKIE_SECURE=true.
# Учётные записи и сессии: <DB_PATH>.auth.db;
# история новых пользователей: <DB_PATH>.environments/<user-id>.db.

# Нужен только удалённым провайдерам с apiKey: ${OPENAI_API_KEY}.
# Для локального режима оставьте пустым и направьте маршруты Auto на local.
OPENAI_API_KEY=
